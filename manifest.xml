<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Manifiesto del complemento "Consolidador de Correos a PDF"
  Para desplegar en producción (ej. GitHub Pages):
  Reemplace todas las instancias de "https://localhost:8080" con su URL de producción HTTPS 
  (ej. "https://su-usuario.github.io/extraccion-correos-pdf").
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  
  <Id>cc8ede85-6326-4c04-909c-3d132ee0f023</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ConsolidadorPDF</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="Consolidador de Correos a PDF" />
  <Description DefaultValue="Consolida múltiples correos seleccionados en un único archivo PDF listo para guardar." />
  
  <!-- Iconos por defecto para clientes antiguos -->
  <IconUrl DefaultValue="https://localhost:8080/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:8080/assets/icon-80.png" />
  
  <SupportUrl DefaultValue="https://localhost:8080/soporte.html" />
  
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  
  <FormSettings>
    <Form xsi:type="ItemRead">
      <Desktop>
        <SourceLocation resid="taskpaneUrl" />
      </Desktop>
    </Form>
  </FormSettings>
  
  <!-- Nivel de permisos requerido para leer múltiples elementos y acceder a loadItemByIdAsync -->
  <Permissions>ReadWriteMailbox</Permissions>
  
  <Rule xsi:type="RuleCollection" Mode="And">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" MinVersion="1.3" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Se activa en el modo Lectura de Mensaje (Bandeja de Entrada / Lista de correos) -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="grpConsolidadorPDF">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="btnConsolidarPDF">
                  <Label resid="buttonLabel" />
                  <Supertip>
                    <Title resid="buttonTitle" />
                    <Description resid="buttonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl" />
                    <!-- Habilita la selección de múltiples elementos en la lista -->
                    <SupportsMultiSelect>true</SupportsMultiSelect>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    
    <Resources>
      <bt:Images>
        <!-- Iconos del botón en la cinta (pueden ser placeholders o imágenes reales) -->
        <bt:Image id="icon16" DefaultValue="https://localhost:8080/assets/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://localhost:8080/assets/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://localhost:8080/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://localhost:8080/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="PDF" />
        <bt:String id="buttonLabel" DefaultValue="Consolidar correos" />
        <bt:String id="buttonTitle" DefaultValue="Consolidador a PDF" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonTooltip" DefaultValue="Consolida los correos seleccionados en un único PDF listo para descargar." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
